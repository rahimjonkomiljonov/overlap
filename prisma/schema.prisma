// Prisma 7: no connection URL here. The Prisma CLI (migrate, studio) gets its URL from
// prisma.config.ts (DIRECT_URL); the running app builds its own adapter from DATABASE_URL
// (the pooled connection) in src/server/db.ts. See docs/BUILD_PLAN.md S03.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- S03/S04/S05 scope: Campus, EmailDomain, User (+ Better Auth's Session, Account,
// Verification), Consent, Waitlist, Cohort, InviteCode, Referral, AuditLog, RateLimit.
// Profile/Course/Match/etc. are later steps (S06+). ---

model Campus {
  id              String   @id @default(uuid())
  name            String
  timeZone        String   @default("Asia/Seoul")
  /// Campus-specific safety contacts (G6): security office, counselling, sexual-violence
  /// / human-rights center. Shape and validation: src/server/reference/schemas.ts
  /// (`safetyResourcesSchema`); written only by the S06 importer. National numbers
  /// (112, 119, 1366, ...) are code constants in src/server/safety/emergency.ts.
  safetyResources Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailDomains EmailDomain[]
  users        User[]
  cohorts      Cohort[]
  waitlist     Waitlist[]
  courses      Course[]
  clubs        Club[]
  spots        Spot[]

  @@map("campuses")
}

model EmailDomain {
  id        String   @id @default(uuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  /// Lowercase, no leading "@", e.g. "yonsei.ac.kr".
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([campusId])
  @@map("email_domains")
}

enum UserStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  BANNED
  DELETED
}

/// Identity fields (name/email/emailVerified/image) plus sessions/accounts are managed
/// by Better Auth (src/server/auth/auth.ts), which expects a model literally named
/// `User` exposing exactly those fields and relations — this is why they're plain
/// fields here rather than under some nested "auth" concern. Everything else
/// (campusId, birthYear, ageVerifiedAt, status, trustScore) is our own domain data,
/// written by our own code (never by Better Auth), not declared to it as
/// `additionalFields` — see docs/BUILD_PLAN.md S05 for why.
///
/// TODO(S16/S19): when account deletion/banning is built, record a keyed hash of the
/// deleted email (src/server/auth/hash.ts) in a separate table before purging it, so a
/// banned identity can be blocked from re-registering (A3) without keeping the
/// plaintext email around. Not needed yet — no deletion flow exists.
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Null only in the brief window between account creation and onboarding finishing
  /// (every user must end up with a campus; there is no sensible default to fall back
  /// on the way there is for status/trustScore).
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  /// Set once at the age gate (A2). Never a full date of birth.
  birthYear     Int?
  ageVerifiedAt DateTime?

  status     UserStatus @default(ACTIVE)
  trustScore Int        @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  consents            Consent[]
  auditLogEntries     AuditLog[]
  referralsAsReferrer Referral[] @relation("ReferrerUser")
  referralAsReferred  Referral?  @relation("ReferredUser")
  profile             Profile?

  @@index([campusId])
  @@map("users")
}

/// Better Auth's session table. "Sign out everywhere" (A5) = deleting every row for a
/// user (authClient.revokeSessions()); Better Auth handles that itself.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better Auth's account table (one row per sign-in method per user). We only use
/// email OTP in Month 1, so accessToken/refreshToken/idToken/password/scope stay null
/// — the table exists because Better Auth's schema contract expects it.
model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

/// Better Auth's OTP/verification-token table (email-otp plugin). Distinct from
/// Waitlist's own OTP fields, which predate account creation entirely.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum ConsentType {
  TERMS
  PRIVACY_POLICY
  /// "Who I'd like to meet" — separate, optional, sensitive under PIPA Art. 23.
  SENSITIVE_PREFERENCE
  /// Deferred: no promotional messages in the local-only / Month-1 phase.
  MARKETING
  MARKETING_NIGHT
  /// Only where the outsourcing-disclosure route in the privacy policy doesn't cover
  /// a given processor (see REQUIREMENTS.md §15.5).
  OVERSEAS_TRANSFER
}

model Consent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type          ConsentType
  /// e.g. "2026-09-23" — the policy/consent-copy version shown when this was recorded.
  policyVersion String
  /// Both grants and explicit declines are recorded; declining is never itself an error.
  granted       Boolean
  grantedAt     DateTime    @default(now())
  withdrawnAt   DateTime?
  /// Where consent was captured, e.g. "onboarding", "settings/privacy".
  source        String

  @@index([userId, type])
  @@map("consents")
}

model Cohort {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  name       String
  /// Density gate (§6/§15): Dating mode opens per cohort only once it qualifies.
  datingOpen Boolean @default(false)

  createdAt   DateTime     @default(now())
  inviteCodes InviteCode[]

  @@index([campusId])
  @@map("cohorts")
}

model InviteCode {
  id       String @id @default(uuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  code      String    @unique
  maxUses   Int       @default(1)
  useCount  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([cohortId])
  @@map("invite_codes")
}

model Waitlist {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  /// Lowercased .ac.kr address. Not sensitive information under PIPA; kept plain (not
  /// hashed) because S04/O8 needs it to send invite emails and to de-duplicate signups.
  email      String
  verifiedAt DateTime?

  /// SHA-256 of the 6-digit code (src/server/auth/otp.ts). Cleared once verified.
  /// Security here is the short expiry + attempt cap, not hash secrecy, so a plain
  /// hash is enough — unlike emailHash, there is no enumeration concern for a code
  /// that's random per row and expires in minutes.
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  /// Pre-account attribution only (who clicked whose link before an account existed).
  /// Confirmed, rewardable referrals are recorded separately in Referral once the
  /// referred person becomes a verified User.
  referredById String?
  referredBy   Waitlist?  @relation("WaitlistReferral", fields: [referredById], references: [id])
  referrals    Waitlist[] @relation("WaitlistReferral")

  /// Required notice/consent checkbox (S04); always set at creation.
  consentedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([campusId, email])
  @@index([referredById])
  @@map("waitlist_signups")
}

model Referral {
  id         String @id @default(uuid())
  code       String @unique
  referrerId String
  referrer   User   @relation("ReferrerUser", fields: [referrerId], references: [id])

  /// Set once the referred person completes verification (S05+). Rewards (badges/event
  /// access, never extra visibility — J3) are granted by Month-2 features on top of this.
  referredUserId String?   @unique
  referredUser   User?     @relation("ReferredUser", fields: [referredUserId], references: [id])
  rewardedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

/// Every admin/moderator action (H3). TODO(S20): REVOKE UPDATE/DELETE for the app's DB
/// role on this table so it is append-only at the database level, not just by convention.
model AuditLog {
  id      String  @id @default(uuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Fixed-window counters for rate limiting (Month-1 choice: Postgres, not Redis — see
/// REQUIREMENTS.md §9). Application logic lives in src/server/auth/rate-limit.ts.
model RateLimit {
  /// e.g. "otp:<emailHash>" or "wave:<userId>:2026-09-23".
  key        String   @id
  count      Int      @default(0)
  windowEnds DateTime

  @@map("rate_limits")
}

// --- S06: reference data (imported from CSV by scripts/import-reference.ts, never
// edited by users). Rows are deactivated, not deleted, when they disappear from a
// re-import, because S07+ user data (enrollments, memberships, answers) will point at
// them. `searchText` is a normalized copy of the searchable fields for autocomplete
// (src/server/reference/normalize.ts), backed by a trigram index so `contains`
// queries (LIKE '%q%') don't scan the table. ---

/// One catalog course per campus and term, e.g. CSE2010 in 2026-2. Sections (and their
/// instructors) hang off it, so shared-course matching (C) can count "same course"
/// and give the same-section bonus separately.
model Course {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// "2026-1" / "2026-2" for regular semesters, "2026-S" / "2026-W" for the summer and
  /// winter sessions (src/server/reference/term.ts).
  term       String
  code       String
  title      String
  titleEn    String?
  searchText String
  active     Boolean @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  CourseSection[]
  enrollees ProfileCourse[]

  @@unique([campusId, term, code])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("courses")
}

model CourseSection {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  section      String
  instructor   String?
  /// As printed in the public timetable (e.g. "월 10:30-12:00, 수 10:30-12:00"); kept as
  /// text in Month 1 — nothing computes on it yet.
  meetingTimes String?
  active       Boolean @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  enrollees ProfileCourse[]

  @@unique([courseId, section])
  @@map("course_sections")
}

/// A club or student organization (동아리/학회). Clubs whose name reveals a sensitive
/// category (religion, politics, ...) are skipped at import — membership would be
/// sensitive information under PIPA Art. 23 (see src/server/reference/sensitive.ts).
model Club {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name        String
  nameEn      String?
  category    String?
  description String?
  searchText  String
  active      Boolean @default(true)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   ProfileClub[]

  @@unique([campusId, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("clubs")
}

enum SpotKind {
  CAFE
  LIBRARY
  DINING
  LOUNGE
  OUTDOOR
  SPORTS
  OTHER
}

/// A curated campus place (B6). `isSafeSpot` = public and staffed/busy enough to
/// suggest for a first meetup (E1); the planner only ever proposes safe spots.
model Spot {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name        String
  nameEn      String?
  kind        SpotKind
  isSafeSpot  Boolean  @default(false)
  description String?
  searchText  String
  active      Boolean  @default(true)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  optedIn   ProfileSpot[]

  @@unique([campusId, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("spots")
}

/// Allowed interest categories. A closed enum on purpose: there is no category a
/// religion/politics/health/sexual-life tag could be filed under (B8), at the database
/// level as well as in the importer's word guard.
enum InterestCategory {
  ARTS
  MUSIC
  SPORTS
  OUTDOORS
  FOOD
  GAMES
  TECH
  READING
  FILM_TV
  TRAVEL
  LEARNING
  SOCIAL
  LIFESTYLE
}

/// Non-sensitive interest taxonomy (B8), shared by every campus.
model InterestTag {
  id         String           @id @default(uuid())
  slug       String           @unique
  category   InterestCategory
  labelKo    String
  labelEn    String
  searchText String
  active     Boolean          @default(true)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  profiles  ProfileInterestTag[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("interest_tags")
}

/// Profile prompt library (B9), shared by every campus. Answers (S07) are ≤ 200 chars.
model Prompt {
  id        String  @id @default(uuid())
  key       String  @unique
  category  String
  textKo    String
  textEn    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   PromptAnswer[]

  @@map("prompts")
}

// --- S07: onboarding profile (B1-B10, B12). Account-level onboarding (age gate,
// campus, consent — S05) must finish first; this can be saved incrementally and
// resumed, and several of its steps are optional per B1. Course/club/spot/interest
// picks stay relational (referential integrity against the S06 reference tables); S10
// derives its own denormalized integer-array feature sets from these at batch time
// (§5.1), rather than this step doing it prematurely. ---

enum Gender {
  WOMAN
  MAN
  NONBINARY
  OTHER
}

enum IntentMode {
  FRIENDS
  STUDY
  DATING
  OPEN
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String?
  gender    Gender?
  pronouns  String?
  year      Int?
  major     String?

  /// Multi-select (B3); per-mode visibility is checked at query time by later steps,
  /// not stored here.
  intents IntentMode[] @default([])

  /// "Who I'd like to meet" (B2) — sensitive information under PIPA Art. 23 (reveals
  /// sexual orientation). Field-encrypted (src/server/privacy/encryption.ts): a
  /// serialized JSON array of Gender values, present only when the user granted
  /// ConsentType.SENSITIVE_PREFERENCE (S05). Decrypted only inside the matching worker
  /// (S10) or this profile's own owner-facing edit form — never rendered anywhere
  /// another user or a moderator can see (G9). Named `interestedIn` (not e.g.
  /// "lookingFor") so a stray log of a Profile object still hits scrub.ts's existing
  /// redaction key.
  interestedIn String?

  /// Flat slot indices 0-83: day (0=Mon..6=Sun) * 12 + two-hour block (0-11). Private;
  /// only the overlap with another user is ever revealed (B7).
  freeTimeSlots Int[] @default([])

  /// 8 Likert answers (1-5), same order as src/server/profile/values-quiz.ts, the only
  /// source of question text — never user-authored, so B10's "no religion/politics/
  /// health/sex-life items" rule can't be bypassed by data.
  valuesAnswers Int[] @default([])

  /// Free-text interests (B8), moderated at write time with the same word guard S06
  /// uses on imported clubs/tags (src/server/reference/sensitive.ts), but never scored
  /// — only the taxonomy tags in `interests` are (REQUIREMENTS.md B8).
  interestsFreeText String[] @default([])

  /// Furthest wizard step reached, so /onboarding/profile can resume here (B1: "saves
  /// progress"). A UI resume point only — completion is `completedAt`, not this.
  onboardingStep Int @default(0)

  /// Set once every required step (basics, >=1 intent, values quiz, 3 prompts, 3-6
  /// photos) is done. Null = still onboarding; the (app) layout guard redirects to
  /// /onboarding/profile until this is set.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       ProfileCourse[]
  clubs         ProfileClub[]
  spots         ProfileSpot[]
  interests     ProfileInterestTag[]
  promptAnswers PromptAnswer[]
  photos        Photo[]

  @@map("profiles")
}

/// Courses this term (B4). `sectionId` is optional — a user may know only the course,
/// not the section — but is needed for C's same-section bonus (§5.2) when given.
model ProfileCourse {
  id        String         @id @default(uuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?
  section   CourseSection? @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([profileId, courseId])
  @@index([courseId])
  @@map("profile_courses")
}

/// Clubs/orgs (B5).
model ProfileClub {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, clubId])
  @@index([clubId])
  @@map("profile_clubs")
}

/// Opt-in hangout spots (B6) — "only ever shown as an overlap", never as a location.
model ProfileSpot {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  spotId    String
  spot      Spot    @relation(fields: [spotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, spotId])
  @@index([spotId])
  @@map("profile_spots")
}

/// Taxonomy interest picks (B8), capped at 12 by Zod at write time (src/server/profile).
model ProfileInterestTag {
  id            String      @id @default(uuid())
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interestTagId String
  interestTag   InterestTag @relation(fields: [interestTagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, interestTagId])
  @@index([interestTagId])
  @@map("profile_interest_tags")
}

/// One answer to one library prompt (B9), <= 200 chars, enforced by Zod at write time.
model PromptAnswer {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    Prompt  @relation(fields: [promptId], references: [id])

  answer    String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, promptId])
  @@index([promptId])
  @@map("prompt_answers")
}

/// 3-6 ordered profile photos (B9). `storageKey` is a private-bucket path, not a public
/// URL (src/server/storage/photos.ts resolves it to a short-lived signed URL, or the
/// local-only dev fallback's guarded route, at render time) — resized and EXIF-stripped
/// by sharp before it ever reaches storage.
model Photo {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  storageKey String
  sortOrder  Int
  width      Int
  height     Int

  createdAt DateTime @default(now())

  @@unique([profileId, sortOrder])
  @@index([profileId])
  @@map("photos")
}
