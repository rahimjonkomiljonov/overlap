// Prisma 7: no connection URL here. The Prisma CLI (migrate, studio) gets its URL from
// prisma.config.ts (DIRECT_URL); the running app builds its own adapter from DATABASE_URL
// (the pooled connection) in src/server/db.ts. See docs/BUILD_PLAN.md S03.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- S03/S04/S05 scope: Campus, EmailDomain, User (+ Better Auth's Session, Account,
// Verification), Consent, Waitlist, Cohort, InviteCode, Referral, AuditLog, RateLimit.
// Profile/Course/Match/etc. are later steps (S06+). ---

model Campus {
  id              String   @id @default(uuid())
  name            String
  timeZone        String   @default("Asia/Seoul")
  /// Campus-specific safety contacts (G6): security office, counselling, sexual-violence
  /// / human-rights center. Shape and validation: src/server/reference/schemas.ts
  /// (`safetyResourcesSchema`); written only by the S06 importer. National numbers
  /// (112, 119, 1366, ...) are code constants in src/server/safety/emergency.ts.
  safetyResources Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailDomains EmailDomain[]
  users        User[]
  cohorts      Cohort[]
  waitlist     Waitlist[]
  courses      Course[]
  clubs        Club[]
  spots        Spot[]
  idfStats     IdfStat[]

  @@map("campuses")
}

model EmailDomain {
  id        String   @id @default(uuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  /// Lowercase, no leading "@", e.g. "yonsei.ac.kr".
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([campusId])
  @@map("email_domains")
}

enum UserStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  BANNED
  DELETED
}

/// H4: least-privilege admin roles. AMBASSADOR is declared now (matches
/// src/server/auth/authz.ts's existing `Role` vocabulary from S03) but nothing grants
/// it or checks for it yet — that's J4 (ambassador dashboard), a later fast-follow.
enum Role {
  USER
  AMBASSADOR
  MODERATOR
  ADMIN
}

/// Identity fields (name/email/emailVerified/image) plus sessions/accounts are managed
/// by Better Auth (src/server/auth/auth.ts), which expects a model literally named
/// `User` exposing exactly those fields and relations — this is why they're plain
/// fields here rather than under some nested "auth" concern. Everything else
/// (campusId, birthYear, ageVerifiedAt, status, trustScore) is our own domain data,
/// written by our own code (never by Better Auth), not declared to it as
/// `additionalFields` — see docs/BUILD_PLAN.md S05 for why.
///
/// TODO(S16/S19): when account deletion/banning is built, record a keyed hash of the
/// deleted email (src/server/auth/hash.ts) in a separate table before purging it, so a
/// banned identity can be blocked from re-registering (A3) without keeping the
/// plaintext email around. Not needed yet — no deletion flow exists.
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Null only in the brief window between account creation and onboarding finishing
  /// (every user must end up with a campus; there is no sensible default to fall back
  /// on the way there is for status/trustScore).
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  /// Set once at the age gate (A2). Never a full date of birth.
  birthYear     Int?
  ageVerifiedAt DateTime?

  status     UserStatus @default(ACTIVE)
  trustScore Int        @default(100)
  role       Role       @default(USER)

  /// Set once a moderator approves a selfie submission (S08/A4). Null = not verified;
  /// unverified users are excluded from appearing in others' picks or sending waves
  /// (enforced by the matching engine, S10 — the candidate query doesn't exist yet).
  verifiedAt DateTime?

  /// True only for rows created by scripts/generate-synthetic-campus.ts (S09),
  /// dev/staging only (CLAUDE.md: "Synthetic users exist only in dev and staging").
  /// src/server/synthetic/guard.ts asserts none exist wherever `NODE_ENV=production`.
  isSynthetic Boolean @default(false)
  /// Which planted community (0-indexed) a synthetic user belongs to — lets S10's
  /// offline evaluation (REQUIREMENTS.md §5.5) check precision@6 against known-good
  /// pairs. Null for every real user and meaningless unless `isSynthetic` is true.
  syntheticCommunity Int?

  /// Touched (throttled to once/hour) by getActor() on every authenticated request.
  /// Backs the "active in the last 14 days" candidate-generation hard filter
  /// (REQUIREMENTS.md §5.1/C5) — src/server/matching/candidates.ts is the only reader.
  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  consents            Consent[]
  auditLogEntries     AuditLog[]
  referralsAsReferrer Referral[] @relation("ReferrerUser")
  referralAsReferred  Referral?  @relation("ReferredUser")
  profile             Profile?
  selfies             Selfie[]   @relation("SelfieOwner")
  selfieDecisions     Selfie[]   @relation("SelfieDecidedBy")
  blocksMade          Block[]      @relation("BlockerUser")
  blocksReceived      Block[]      @relation("BlockedUser")
  hideRulesOwned      HideRule[]   @relation("HideRuleOwner")
  hideRulesTargeting  HideRule[]   @relation("HideRuleTarget")
  dailyBatches        DailyBatch[]
  batchAppearances    BatchItem[]  @relation("BatchItemCandidate")
  wavesSent           Wave[]       @relation("WaveSender")
  wavesReceived       Wave[]       @relation("WaveRecipient")

  @@index([campusId])
  @@map("users")
}

/// Better Auth's session table. "Sign out everywhere" (A5) = deleting every row for a
/// user (authClient.revokeSessions()); Better Auth handles that itself.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better Auth's account table (one row per sign-in method per user). We only use
/// email OTP in Month 1, so accessToken/refreshToken/idToken/password/scope stay null
/// — the table exists because Better Auth's schema contract expects it.
model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

/// Better Auth's OTP/verification-token table (email-otp plugin). Distinct from
/// Waitlist's own OTP fields, which predate account creation entirely.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum ConsentType {
  TERMS
  PRIVACY_POLICY
  /// "Who I'd like to meet" — separate, optional, sensitive under PIPA Art. 23.
  SENSITIVE_PREFERENCE
  /// Deferred: no promotional messages in the local-only / Month-1 phase.
  MARKETING
  MARKETING_NIGHT
  /// Only where the outsourcing-disclosure route in the privacy policy doesn't cover
  /// a given processor (see REQUIREMENTS.md §15.5).
  OVERSEAS_TRANSFER
}

model Consent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type          ConsentType
  /// e.g. "2026-09-23" — the policy/consent-copy version shown when this was recorded.
  policyVersion String
  /// Both grants and explicit declines are recorded; declining is never itself an error.
  granted       Boolean
  grantedAt     DateTime    @default(now())
  withdrawnAt   DateTime?
  /// Where consent was captured, e.g. "onboarding", "settings/privacy".
  source        String

  @@index([userId, type])
  @@map("consents")
}

model Cohort {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  name       String
  /// Density gate (§6/§15): Dating mode opens per cohort only once it qualifies.
  datingOpen Boolean @default(false)

  createdAt   DateTime     @default(now())
  inviteCodes InviteCode[]

  @@index([campusId])
  @@map("cohorts")
}

model InviteCode {
  id       String @id @default(uuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  code      String    @unique
  maxUses   Int       @default(1)
  useCount  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([cohortId])
  @@map("invite_codes")
}

model Waitlist {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  /// Lowercased .ac.kr address. Not sensitive information under PIPA; kept plain (not
  /// hashed) because S04/O8 needs it to send invite emails and to de-duplicate signups.
  email      String
  verifiedAt DateTime?

  /// SHA-256 of the 6-digit code (src/server/auth/otp.ts). Cleared once verified.
  /// Security here is the short expiry + attempt cap, not hash secrecy, so a plain
  /// hash is enough — unlike emailHash, there is no enumeration concern for a code
  /// that's random per row and expires in minutes.
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  /// Pre-account attribution only (who clicked whose link before an account existed).
  /// Confirmed, rewardable referrals are recorded separately in Referral once the
  /// referred person becomes a verified User.
  referredById String?
  referredBy   Waitlist?  @relation("WaitlistReferral", fields: [referredById], references: [id])
  referrals    Waitlist[] @relation("WaitlistReferral")

  /// Required notice/consent checkbox (S04); always set at creation.
  consentedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([campusId, email])
  @@index([referredById])
  @@map("waitlist_signups")
}

model Referral {
  id         String @id @default(uuid())
  code       String @unique
  referrerId String
  referrer   User   @relation("ReferrerUser", fields: [referrerId], references: [id])

  /// Set once the referred person completes verification (S05+). Rewards (badges/event
  /// access, never extra visibility — J3) are granted by Month-2 features on top of this.
  referredUserId String?   @unique
  referredUser   User?     @relation("ReferredUser", fields: [referredUserId], references: [id])
  rewardedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

/// Every admin/moderator action (H3). TODO(S20): REVOKE UPDATE/DELETE for the app's DB
/// role on this table so it is append-only at the database level, not just by convention.
model AuditLog {
  id      String  @id @default(uuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Fixed-window counters for rate limiting (Month-1 choice: Postgres, not Redis — see
/// REQUIREMENTS.md §9). Application logic lives in src/server/auth/rate-limit.ts.
model RateLimit {
  /// e.g. "otp:<emailHash>" or "wave:<userId>:2026-09-23".
  key        String   @id
  count      Int      @default(0)
  windowEnds DateTime

  @@map("rate_limits")
}

// --- S06: reference data (imported from CSV by scripts/import-reference.ts, never
// edited by users). Rows are deactivated, not deleted, when they disappear from a
// re-import, because S07+ user data (enrollments, memberships, answers) will point at
// them. `searchText` is a normalized copy of the searchable fields for autocomplete
// (src/server/reference/normalize.ts), backed by a trigram index so `contains`
// queries (LIKE '%q%') don't scan the table. ---

/// One catalog course per campus and term, e.g. CSE2010 in 2026-2. Sections (and their
/// instructors) hang off it, so shared-course matching (C) can count "same course"
/// and give the same-section bonus separately.
model Course {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// "2026-1" / "2026-2" for regular semesters, "2026-S" / "2026-W" for the summer and
  /// winter sessions (src/server/reference/term.ts).
  term       String
  code       String
  title      String
  titleEn    String?
  searchText String
  active     Boolean @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  CourseSection[]
  enrollees ProfileCourse[]

  @@unique([campusId, term, code])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("courses")
}

model CourseSection {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  section      String
  instructor   String?
  /// As printed in the public timetable (e.g. "월 10:30-12:00, 수 10:30-12:00"); kept as
  /// text in Month 1 — nothing computes on it yet.
  meetingTimes String?
  active       Boolean @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  enrollees ProfileCourse[]

  @@unique([courseId, section])
  @@map("course_sections")
}

/// A club or student organization (동아리/학회). Clubs whose name reveals a sensitive
/// category (religion, politics, ...) are skipped at import — membership would be
/// sensitive information under PIPA Art. 23 (see src/server/reference/sensitive.ts).
model Club {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name        String
  nameEn      String?
  category    String?
  description String?
  searchText  String
  active      Boolean @default(true)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   ProfileClub[]

  @@unique([campusId, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("clubs")
}

enum SpotKind {
  CAFE
  LIBRARY
  DINING
  LOUNGE
  OUTDOOR
  SPORTS
  OTHER
}

/// A curated campus place (B6). `isSafeSpot` = public and staffed/busy enough to
/// suggest for a first meetup (E1); the planner only ever proposes safe spots.
model Spot {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name        String
  nameEn      String?
  kind        SpotKind
  isSafeSpot  Boolean  @default(false)
  description String?
  searchText  String
  active      Boolean  @default(true)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  optedIn   ProfileSpot[]

  @@unique([campusId, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("spots")
}

/// Allowed interest categories. A closed enum on purpose: there is no category a
/// religion/politics/health/sexual-life tag could be filed under (B8), at the database
/// level as well as in the importer's word guard.
enum InterestCategory {
  ARTS
  MUSIC
  SPORTS
  OUTDOORS
  FOOD
  GAMES
  TECH
  READING
  FILM_TV
  TRAVEL
  LEARNING
  SOCIAL
  LIFESTYLE
}

/// Non-sensitive interest taxonomy (B8), shared by every campus.
model InterestTag {
  id         String           @id @default(uuid())
  slug       String           @unique
  category   InterestCategory
  labelKo    String
  labelEn    String
  searchText String
  active     Boolean          @default(true)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  profiles  ProfileInterestTag[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("interest_tags")
}

/// Profile prompt library (B9), shared by every campus. Answers (S07) are ≤ 200 chars.
model Prompt {
  id        String  @id @default(uuid())
  key       String  @unique
  category  String
  textKo    String
  textEn    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   PromptAnswer[]

  @@map("prompts")
}

// --- S07: onboarding profile (B1-B10, B12). Account-level onboarding (age gate,
// campus, consent — S05) must finish first; this can be saved incrementally and
// resumed, and several of its steps are optional per B1. Course/club/spot/interest
// picks stay relational (referential integrity against the S06 reference tables); S10
// derives its own denormalized integer-array feature sets from these at batch time
// (§5.1), rather than this step doing it prematurely. ---

enum Gender {
  WOMAN
  MAN
  NONBINARY
  OTHER
}

enum IntentMode {
  FRIENDS
  STUDY
  DATING
  OPEN
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String?
  gender    Gender?
  pronouns  String?
  year      Int?
  major     String?

  /// Multi-select (B3); per-mode visibility is checked at query time by later steps,
  /// not stored here.
  intents IntentMode[] @default([])

  /// "Who I'd like to meet" (B2) — sensitive information under PIPA Art. 23 (reveals
  /// sexual orientation). Field-encrypted (src/server/privacy/encryption.ts): a
  /// serialized JSON array of Gender values, present only when the user granted
  /// ConsentType.SENSITIVE_PREFERENCE (S05). Decrypted only inside the matching worker
  /// (S10) or this profile's own owner-facing edit form — never rendered anywhere
  /// another user or a moderator can see (G9). Named `interestedIn` (not e.g.
  /// "lookingFor") so a stray log of a Profile object still hits scrub.ts's existing
  /// redaction key.
  interestedIn String?

  /// Flat slot indices 0-83: day (0=Mon..6=Sun) * 12 + two-hour block (0-11). Private;
  /// only the overlap with another user is ever revealed (B7).
  freeTimeSlots Int[] @default([])

  /// 8 Likert answers (1-5), same order as src/server/profile/values-quiz.ts, the only
  /// source of question text — never user-authored, so B10's "no religion/politics/
  /// health/sex-life items" rule can't be bypassed by data.
  valuesAnswers Int[] @default([])

  /// Free-text interests (B8), moderated at write time with the same word guard S06
  /// uses on imported clubs/tags (src/server/reference/sensitive.ts), but never scored
  /// — only the taxonomy tags in `interests` are (REQUIREMENTS.md B8).
  interestsFreeText String[] @default([])

  /// Furthest wizard step reached, so /onboarding/profile can resume here (B1: "saves
  /// progress"). A UI resume point only — completion is `completedAt`, not this.
  onboardingStep Int @default(0)

  /// Set once every required step (basics, >=1 intent, values quiz, 3 prompts, 3-6
  /// photos) is done. Null = still onboarding; the (app) layout guard redirects to
  /// /onboarding/profile until this is set.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       ProfileCourse[]
  clubs         ProfileClub[]
  spots         ProfileSpot[]
  interests     ProfileInterestTag[]
  promptAnswers PromptAnswer[]
  photos        Photo[]

  @@map("profiles")
}

/// Courses this term (B4). `sectionId` is optional — a user may know only the course,
/// not the section — but is needed for C's same-section bonus (§5.2) when given.
model ProfileCourse {
  id        String         @id @default(uuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?
  section   CourseSection? @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([profileId, courseId])
  @@index([courseId])
  @@map("profile_courses")
}

/// Clubs/orgs (B5).
model ProfileClub {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, clubId])
  @@index([clubId])
  @@map("profile_clubs")
}

/// Opt-in hangout spots (B6) — "only ever shown as an overlap", never as a location.
model ProfileSpot {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  spotId    String
  spot      Spot    @relation(fields: [spotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, spotId])
  @@index([spotId])
  @@map("profile_spots")
}

/// Taxonomy interest picks (B8), capped at 12 by Zod at write time (src/server/profile).
model ProfileInterestTag {
  id            String      @id @default(uuid())
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interestTagId String
  interestTag   InterestTag @relation(fields: [interestTagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, interestTagId])
  @@index([interestTagId])
  @@map("profile_interest_tags")
}

/// One answer to one library prompt (B9), <= 200 chars, enforced by Zod at write time.
model PromptAnswer {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    Prompt  @relation(fields: [promptId], references: [id])

  answer    String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, promptId])
  @@index([promptId])
  @@map("prompt_answers")
}

/// 3-6 ordered profile photos (B9). `storageKey` is a private-bucket path, not a public
/// URL (src/server/storage/photos.ts resolves it to a short-lived signed URL, or the
/// local-only dev fallback's guarded route, at render time) — resized and EXIF-stripped
/// by sharp before it ever reaches storage.
model Photo {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  storageKey String
  sortOrder  Int
  width      Int
  height     Int

  createdAt DateTime @default(now())

  @@unique([profileId, sortOrder])
  @@index([profileId])
  @@map("photos")
}

// --- S08: photo verification (A4, H2). A dedicated model rather than reusing Photo:
// selfies have a completely different lifecycle (private, moderator-only, purged
// within 7 days of the decision — REQUIREMENTS.md §15.4), so sharing a table would mean
// every query on either concern needs to filter the other one out. ---

enum VerificationDecision {
  PENDING
  APPROVED
  REJECTED
}

/// One verification attempt. A user can resubmit after a rejection, so this is a log of
/// attempts, not a single row per user — the queue (H2) works the latest PENDING one per
/// user. `storageKey` is nulled by the purge job once `purgedAt` is set; the row itself
/// (decision, reason, timestamps) is kept for the audit trail (H3) and appeal record.
model Selfie {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("SelfieOwner", fields: [userId], references: [id], onDelete: Cascade)

  storageKey  String?
  submittedAt DateTime @default(now())

  decision    VerificationDecision @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?                @relation("SelfieDecidedBy", fields: [decidedById], references: [id])
  /// Required on rejection (shown to the user so they know what to fix); optional on
  /// approval.
  reason      String?

  /// Set when the purge job deletes the underlying image (≤ 7 days after `decidedAt`).
  purgedAt DateTime?

  @@index([userId])
  @@index([decision, submittedAt])
  @@map("selfies")
}

// --- S09: IDF statistics feeding the matching engine's C/K/I terms (§5.2). Computed by
// src/server/matching/idf.ts, scoped per campus since the candidate pool (and therefore
// what counts as "rare") is per-campus, not global. Refreshed nightly once a cron job
// exists (S11); S09 just builds the job function and a CLI to run it by hand. ---

enum IdfFeatureType {
  COURSE
  CLUB
  INTEREST
}

/// One row per (campus, feature). `count` is n_x — how many eligible (verified,
/// profile-complete) users on this campus have this feature; `idf` is
/// `log(N / (1 + n_x))` capped at 0 (REQUIREMENTS.md §5.2), where N is that campus's
/// eligible-user count. featureId points at a Course/Club/InterestTag id depending on
/// featureType, but isn't a foreign key — a stale stat for a since-deactivated feature
/// is harmless (S10's scoring only ever looks up stats for features a candidate
/// actually has) and this avoids three nullable FK columns for one row shape.
model IdfStat {
  id       String @id @default(uuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  featureType IdfFeatureType
  featureId   String
  count       Int
  idf         Float

  updatedAt DateTime @updatedAt

  @@unique([campusId, featureType, featureId])
  @@index([campusId, featureType])
  @@map("idf_stats")
}

// --- S10: matching engine. Candidate generation and scoring themselves are code
// (src/server/matching/), not tables — these four models are what that code reads
// (Block/HideRule, as hard filters) and writes (DailyBatch/BatchItem, the persisted
// result). S10 only builds the scoring/candidate pipeline as pure functions plus a
// migration for these tables; S11 is what actually calls them daily per user/intent and
// persists rows here. ---

/// Mutual: either side may have created the row, and it excludes the pair in both
/// directions (REQUIREMENTS.md §5.1: "not blocked ... either way") — unlike HideRule,
/// which is one-directional.
model Block {
  id String @id @default(uuid())

  blockerId String
  blocker   User   @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// One-directional: only removes `hiddenUser` from `user`'s own candidate pool, unlike
/// Block. REQUIREMENTS.md §10 describes this as "hide by course/club/email" — read as
/// three ways a future settings UI could let someone *find* who to hide (search by
/// shared course, club, or a known email), not three different filter shapes to store;
/// what's persisted is always just the resolved target user; §5.1's hard-filter list
/// only needs "is this specific person hidden", regardless of how they were found.
model HideRule {
  id String @id @default(uuid())

  userId       String
  user         User   @relation("HideRuleOwner", fields: [userId], references: [id], onDelete: Cascade)
  hiddenUserId String
  hiddenUser   User   @relation("HideRuleTarget", fields: [hiddenUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, hiddenUserId])
  @@map("hide_rules")
}

/// One user's picks for one intent on one day (§5.3's "daily batch composition" — S11
/// builds the composition itself; this is just where it lands). The unique constraint is
/// what makes generating a batch idempotent per user/intent/day (S11's own "Done when").
model DailyBatch {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent IntentMode

  /// Calendar date only (Asia/Seoul), not a timestamp — "one batch per day" per §5.3.
  batchDate DateTime @db.Date
  createdAt DateTime @default(now())

  items BatchItem[]

  @@unique([userId, intent, batchDate])
  @@map("daily_batches")
}

// --- S12: picks UI (wave/pass). BatchItem.decision is the *only* place "seen and acted
// on" lives — the candidate query (S10) already excludes anything shown in the last 30
// days by BatchItem existing at all, regardless of decision, so this isn't a second
// exclusion mechanism, just what /picks uses to know which of today's items are still
// actionable ("you're caught up" = none are). ---

enum PickDecision {
  WAVED
  PASSED
}

/// One ranked candidate within a DailyBatch. `reasons` holds structured explanation data
/// (never rendered text — §5.2: "top 3 contributing terms are rendered from templates"),
/// so locale/copy changes never require a backfill. `rank` is the position S11's
/// composition logic (4 top + 1 adjacent + 1 newcomer) placed this candidate at, not
/// necessarily its raw score order.
model BatchItem {
  id String @id @default(uuid())

  dailyBatchId String
  dailyBatch   DailyBatch @relation(fields: [dailyBatchId], references: [id], onDelete: Cascade)

  candidateUserId String
  candidate       User   @relation("BatchItemCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// 0-100, from src/server/matching/score.ts's S(a,b) (§5.2).
  score   Float
  reasons Json
  rank    Int

  /// Null = still in the user's queue. Set once by src/server/picks/actions.ts and never
  /// changed after — a decision is final for this pick, matching REQUIREMENTS.md's Wave
  /// entity, not a preference toggle.
  decision  PickDecision?
  decidedAt DateTime?

  wave Wave?

  createdAt DateTime @default(now())

  @@unique([dailyBatchId, candidateUserId])
  @@index([candidateUserId])
  @@map("batch_items")
}

/// A wave sent from one pick (S12). Reciprocal-wave → match detection, the 8/day send
/// cap, the waves inbox and the matches list are S14's job ("Waves and matches") — this
/// is only the compose-and-send half, which S12 needs to make its wave composer real
/// rather than a UI mock. `status` starts and stays PENDING until S14 adds the logic that
/// changes it.
enum WaveStatus {
  PENDING
  MATCHED
  DECLINED
}

model Wave {
  id String @id @default(uuid())

  /// The pick this wave was sent from — lets a future inbox show the same "why you
  /// overlap" context the sender saw, and makes a wave impossible without a real,
  /// currently-actionable pick (enforced in src/server/picks/actions.ts, not here).
  batchItemId String @unique
  batchItem   BatchItem @relation(fields: [batchItemId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("WaveSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("WaveRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  /// What was reacted to — a specific photo or prompt answer, or a generic profile-level
  /// wave. Structured, like BatchItem.reasons, so the recipient's UI (S14) can render it
  /// in either locale without a backfill.
  targetElement Json
  /// ≤140 chars, optional (src/server/picks/schema.ts).
  note   String?
  status WaveStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("waves")
}
