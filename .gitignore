# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values never committed, the example file is
.env*
!.env.example

# test output
/playwright-report/
/test-results/
/blob-report/

# local Claude Code settings
/.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: generated client code, regenerated by `npm install` (postinstall) and CI
/src/generated/

# dev-only email outbox (src/server/email/send.ts), read by e2e/waitlist.spec.ts
/.dev-outbox.jsonl

# dev-only photo storage fallback (src/server/storage/photos.ts) when Supabase Storage
# isn't configured
/.dev-storage/

# dev-only local alerting substitute for Sentry (src/server/ops/alerts.ts, S21), read by
# the /admin/ops dashboard
/.dev-alerts.jsonl

.vercel
.env*

# dev-only web push outbox (src/server/push/send.ts) when VAPID keys are unset
/.dev-push.jsonl
.playwright-mcp/
