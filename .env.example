# Copy to .env.local and fill in. Never commit .env.local or real values.
# Names only: real values live in Vercel / Supabase project settings.
#
# LOCAL-ONLY PHASE: no domain, no production deploy, no real email sending until the
# owner says "publish" (see docs/BUILD_PLAN.md).

# --- S01 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- S02 ---
# Set to "true" to enable the /dev/ui design-system gallery. Never set in production.
# ENABLE_DEV_UI=true

# --- Supabase project (owner task O3) ---
# Dashboard -> your project -> "Connect" -> ORMs tab, or Project Settings -> API Keys.
# Client-side (safe to expose; used by Supabase Auth in the browser, S05):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (S07/S08, storage). Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# --- S03: two Postgres connection strings from the same Supabase project ---
# Dashboard -> "Connect" -> ORMs tab -> Prisma; paste in your database password.
# DATABASE_URL: Transaction pooler, port 6543, keep "?pgbouncer=true".
# DATABASE_URL=
# DIRECT_URL: Session pooler or direct connection, port 5432, no pgbouncer flag.
# DIRECT_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sensitive fields.
# FIELD_ENCRYPTION_KEY=

# --- S04 (owner task O2: domain + Resend; deferred, see LOCAL-ONLY PHASE above) ---
# Until set, OTP codes are logged to the server console instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=

# --- S11 (protects the daily-picks cron route) ---
# Any long random string (openssl rand -hex 32).
# CRON_SECRET=

# --- S20 (owner task O3: Sentry, EU region; deferred, see LOCAL-ONLY PHASE above) ---
# SENTRY_DSN=
