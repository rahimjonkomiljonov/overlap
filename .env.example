# Copy to .env.local and fill in. Never commit .env.local or real values.
# Names only: real values live in Vercel / Supabase project settings.

# --- S01 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- S02 ---
# Set to "true" to enable the /dev/ui design-system gallery. Never set in production.
# ENABLE_DEV_UI=true

# --- S03 (owner task O3: Supabase Pro project in Seoul, ap-northeast-2) ---
# DATABASE_URL=
# DIRECT_URL=
# FIELD_ENCRYPTION_KEY=          # 32 random bytes, base64. Encrypts sensitive fields.

# --- S04 (owner task O2: domain + Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM=

# --- S07/S08 (private storage bucket, Seoul) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=     # server only, never exposed to the browser

# --- S11 (protects the daily-picks cron route) ---
# CRON_SECRET=

# --- S20 (owner task O3: Sentry, EU region) ---
# SENTRY_DSN=
