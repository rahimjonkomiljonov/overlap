# Copy to .env.local and fill in. Never commit .env.local or real values.
# Names only: real values live in Vercel / Supabase project settings.
#
# LOCAL-ONLY PHASE: no domain, no production deploy, no real email sending until the
# owner says "publish" (see docs/BUILD_PLAN.md).

# --- S01 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- S02 ---
# Set to "true" to enable the /dev/ui design-system gallery. Never set in production.
# ENABLE_DEV_UI=true

# --- Supabase project (owner task O3) ---
# Dashboard -> your project -> "Connect" -> ORMs tab, or Project Settings -> API Keys.
# Auth ended up on Better Auth instead of Supabase Auth (see docs/BUILD_PLAN.md S05 log:
# Supabase Auth's default email sending doesn't fit the local-only phase). These stay
# for Supabase Storage later (S07/S08, photo uploads) — a separate, still-planned use.
# Client-side (safe to expose):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# --- S03: two Postgres connection strings from the same Supabase project ---
# Dashboard -> "Connect" -> ORMs tab -> Prisma; paste in your database password (the
# password is the whole bracketed placeholder — don't keep the [ ] characters).
# DATABASE_URL: Transaction pooler, port 6543, keep "?pgbouncer=true".
# DATABASE_URL=
# DIRECT_URL: Session pooler or direct connection, port 5432, no pgbouncer flag.
# DIRECT_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sensitive fields, versioned
# for rotation — see src/server/privacy/encryption.ts. Add _V2, _V3... to rotate.
# FIELD_ENCRYPTION_KEY_V1=
# HMAC pepper for hashing campus emails (openssl rand -hex 32). See src/server/auth/hash.ts
# for why this must never be a plain, unkeyed hash.
# EMAIL_HASH_PEPPER=

# --- S04 (owner task O2: domain + Resend; deferred, see LOCAL-ONLY PHASE above) ---
# Until set, OTP codes are logged to the server console instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=

# --- S05: Better Auth (src/server/auth/auth.ts) ---
# 32 random bytes, base64 (openssl rand -base64 32). Signs/encrypts session tokens;
# rotating it invalidates every existing session.
# BETTER_AUTH_SECRET=
# Must match where the app is actually served; update when a real domain exists.
# BETTER_AUTH_URL=http://localhost:3000

# --- S11 (protects the daily-picks cron route) ---
# Any long random string (openssl rand -hex 32).
# CRON_SECRET=

# --- S20 (owner task O3: Sentry, EU region; deferred, see LOCAL-ONLY PHASE above) ---
# SENTRY_DSN=

# --- Fast-follow: realtime chat via Supabase Realtime Broadcast (src/server/chat/realtime.ts) ---
# 32 random bytes, hex (openssl rand -hex 32). Derives an unguessable per-conversation
# channel name — never reuse EMAIL_HASH_PEPPER/FIELD_ENCRYPTION_KEY_V1 for this, different
# security domain. Optional: unset falls back to polling only (same as Storage above).
# CHAT_CHANNEL_SECRET=

# --- S26: cohort release (src/server/cohorts/release.ts) ---
# "on" requires an invite code at onboarding and gates Dating per cohort (density gate).
# Leave unset for local dev, CI and the private demo. Turn on only for a real launch.
# COHORT_RELEASE=on

# --- Month-2 #7: web push (src/server/push/send.ts) ---
# Generate once: npx web-push generate-vapid-keys. The public key alone lets browsers
# subscribe; pushes still go only to the gitignored .dev-push.jsonl. Setting the private
# key too turns on real delivery through the browser vendors' push services, so leave it
# unset until the owner says "publish" (local-only phase).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL (defaults to NEXT_PUBLIC_SITE_URL).
# VAPID_SUBJECT=
